        {
          "id": "28dd0225-38e6-4c94-9619-2cc611688ba8",
          "name": "List tables in namespace",
          "request": {
            "name": "List tables in namespace",
            "description": {
              "content": "Returns a list of tables in the specified namespace within an R2 catalog.\nSupports pagination for efficient traversal of large table collections.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "r2-catalog",
                ":bucket_name",
                "namespaces",
                ":namespace",
                "tables"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page_token",
                  "value": "<string>",
                  "description": "Opaque pagination token from a previous response.\nUse this to fetch the next page of results.\n"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "100",
                  "description": "Maximum number of tables to return per page.\nDefaults to 100, maximum 1000.\n"
                },
                {
                  "disabled": false,
                  "key": "return_uuids",
                  "value": "false",
                  "description": "Whether to include table UUIDs in the response.\nSet to true to receive the table_uuids array.\n"
                },
                {
                  "disabled": false,
                  "key": "return_details",
                  "value": "false",
                  "description": "Whether to include additional metadata (timestamps, locations).\nWhen true, response includes created_at, updated_at, metadata_locations, and locations arrays.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) Identifies the account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "bucket_name",
                  "description": "(Required) Specifies the R2 bucket name."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "namespace",
                  "description": "(Required) The namespace identifier.\nFor nested namespaces, use %1F as separator (e.g., \"bronze%1Fanalytics\").\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
