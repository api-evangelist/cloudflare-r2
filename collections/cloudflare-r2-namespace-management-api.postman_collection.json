      "item": [
        {
          "id": "6aa24a33-3526-4c22-9cf3-995183807746",
          "name": "List namespaces in catalog",
          "request": {
            "name": "List namespaces in catalog",
            "description": {
              "content": "Returns a list of namespaces in the specified R2 catalog.\nSupports hierarchical filtering and pagination for efficient traversal\nof large namespace hierarchies.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "r2-catalog",
                ":bucket_name",
                "namespaces"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page_token",
                  "value": "<string>",
                  "description": "Opaque pagination token from a previous response.\nUse this to fetch the next page of results.\n"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "100",
                  "description": "Maximum number of namespaces to return per page.\nDefaults to 100, maximum 1000.\n"
                },
                {
                  "disabled": false,
                  "key": "parent",
                  "value": "<string>",
                  "description": "Parent namespace to filter by. Only returns direct children of this namespace.\nFor nested namespaces, use %1F as separator (e.g., \"bronze%1Fanalytics\").\nOmit this parameter to list top-level namespaces.\n"
                },
                {
                  "disabled": false,
                  "key": "return_uuids",
                  "value": "false",
                  "description": "Whether to include namespace UUIDs in the response.\nSet to true to receive the namespace_uuids array.\n"
                },
                {
                  "disabled": false,
                  "key": "return_details",
                  "value": "false",
                  "description": "Whether to include additional metadata (timestamps).\nWhen true, response includes created_at and updated_at arrays.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) Identifies the account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "bucket_name",
                  "description": "(Required) Specifies the R2 bucket name."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
